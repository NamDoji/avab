generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  phone         String    @unique
  email         String?   @unique
  password      String
  role          String    @default("STUDENT")
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments   Enrollment[]
  answers       StudentAnswer[]

  @@map("avab_users")
}

enum CourseType {
  TOAN
  TIENG_ANH
  LAP_TRINH_THUAT_TOAN
  LAP_TRINH_SCRATCH
  LAP_TRINH_PYTHON
  LAP_TRINH_CPP
}

model Course {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  thumbnail   String?
  price       Int?       @default(0)
  courseType  CourseType @default(TOAN)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  subjects    Subject[]
  enrollments Enrollment[]

  @@map("avab_courses")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  status    String   @default("PENDING")
  note      String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("avab_enrollments")
}

model Subject {
  id          String   @id @default(cuid())
  courseId    String
  order       Int      @default(0)
  name        String
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials    SubjectMaterial[]
  questions    Question[]
  homeworkSets HomeworkSet[]

  @@map("avab_subjects")
}

model HomeworkSet {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  order     Int      @default(0)
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("avab_homework_sets")
}

model SubjectMaterial {
  id        String   @id @default(cuid())
  subjectId String
  type      String
  title     String?
  content   String?
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("avab_subject_materials")
}

model Question {
  id            String   @id @default(cuid())
  subjectId     String
  homeworkSetId String?
  order         Int      @default(0)
  questionType  String   @default("OPEN")
  content       String
  imageUrl      String?
  audioUrl      String?
  options       Json?    // [{key:"A",text:"..."}, ...] for MULTIPLE_CHOICE; [{left,right}] for MATCHING
  correctAnswer String
  explanation   String?
  points        Int      @default(1)
  metadata      Json?    // extra data per question type
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  homeworkSet HomeworkSet? @relation(fields: [homeworkSetId], references: [id], onDelete: SetNull)
  answers     StudentAnswer[]

  @@map("avab_questions")
}

model StudentAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  subjectId  String
  answer     String
  isCorrect  Boolean  @default(false)
  score      Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("avab_student_answers")
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String?
  content     String
  thumbnail   String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("avab_news")
}

model Recruitment {
  id           String   @id @default(cuid())
  title        String
  type         String
  description  String
  requirements String?
  benefits     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("avab_recruitments")
}

model Registration {
  id        String   @id @default(cuid())
  name      String?
  phone     String
  email     String?
  note      String?
  type      String   @default("CONTACT")  // CONTACT | ENROLLMENT
  status    String   @default("NEW")      // NEW | WON | LOST | FOLLOWUP
  note2     String?                       // Ghi chú admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("avab_registrations")
}
