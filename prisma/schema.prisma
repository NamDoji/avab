generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  phone         String    @unique
  email         String?   @unique
  password      String
  role          String    @default("STUDENT")
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments       Enrollment[]
  answers           StudentAnswer[]
  learnerProfile    LearnerProfile?
  sessionRecords    StudentSessionRecord[]
  aiCaches          AIAnalysisCache[]
  aiRefreshedAt     DateTime?  // Lần cuối refresh AI analysis
  parentLinks       ParentStudentLink[] @relation("ParentLinks")
  studentLinks      ParentStudentLink[] @relation("StudentLinks")
  aiProjects        AIProject[]
  userRoles         UserRole[]
  auditLogs         AuditLog[]
  userBadges        UserBadge[]
  userMissions      UserMission[]
  userStats         UserStats?
  organizationUsers OrganizationUser[]
  campusUsers       CampusUser[]
  schoolUsers       SchoolUser[]

  @@map("avab_users")
}

// A2PLM — Hồ sơ người học (P_i) + Mục tiêu (G_i)
model LearnerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  // P_i — Hồ sơ người học
  backgroundLevel   String    @default("BEGINNER")   // BEGINNER | INTERMEDIATE | ADVANCED
  learningStyle     String    @default("MIXED")       // VISUAL | READING | KINESTHETIC | MIXED
  selfStudyCapacity String    @default("MEDIUM")      // LOW | MEDIUM | HIGH
  parentInvolvement String    @default("MEDIUM")      // LOW | MEDIUM | HIGH
  weeklyHours       Int       @default(5)              // Số giờ học mỗi tuần
  // G_i — Mục tiêu học tập
  targetSchool      String?                           // Trường mục tiêu (VD: Nguyễn Siêu)
  targetDate        DateTime?                         // Deadline kỳ thi
  targetGoal        String    @default("SCHOLARSHIP") // SCHOLARSHIP | FOUNDATION | ADVANCED
  additionalNotes   String?                           // Ghi chú thêm từ phụ huynh
  // Metadata
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avab_learner_profiles")
}

// CourseType enum removed — K12 Refactor. courseType is now a plain String field.
// New field: subjectCode (generic K12 subject code, e.g. THINKING_MATH, ENGLISH, CODING, SCIENCE...)

// Loại thu tiền: theo khoá (18 tháng) hoặc theo buổi
enum PaymentType {
  PER_COURSE
  PER_SESSION
}

model Course {
  id                   String      @id @default(cuid())
  code                 String      @unique
  name                 String
  description          String?
  thumbnail            String?
  price                Int?        @default(0)
  courseType           String      @default("TOAN")      // Legacy field kept for backward compat
  subjectCode          String      @default("GENERAL")   // K12 generic: THINKING_MATH, ENGLISH, MATH, CODING, SCIENCE...
  subjectName          String?                            // Tên môn hiển thị (e.g. "Toán Tư Duy", "Tiếng Anh Cambridge")
  gradeMin             Int?                               // Lớp bắt đầu (1–12; 0 = mầm non)
  gradeMax             Int?                               // Lớp kết thúc (null = single grade)
  curriculumId         String?                            // FK → Curriculum (optional, backward compat)
  // Loại thu tiền
  paymentType          PaymentType @default(PER_COURSE)
  pricePerSession      Int?        // Giá mỗi buổi khi paymentType = PER_SESSION
  courseDurationMonths Int         @default(18) // Số tháng hiệu lực khi PER_COURSE
  // Lớp (Grades 1–9)
  grade                String?     // null = dành cho mọi lớp; "1".."9"
  homeworkCount        Int         @default(30)        // Số bài tập / chuyên đề
  quizCount            Int         @default(20)        // Số câu trong đề kiểm tra
  organizationId       String?                        // null = AvaB platform course
  campusId             String?                        // null = shared across campuses
  isPublic             Boolean     @default(false)    // true = hiển thị trên public frontend (avab.vn/khoa-hoc)
  isActive             Boolean     @default(true)
  approvalStatus       String      @default("draft") // draft | review | approved | published | archived
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  subjects            Subject[]
  enrollments         Enrollment[]
  tuitionCollections  TuitionCollection[]
  curriculum          Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  organization        Organization? @relation("OrgCourses", fields: [organizationId], references: [id], onDelete: SetNull)
  schoolCourses       SchoolCourse[]

  @@map("avab_courses")
}

// ── K12 Curriculum hierarchy —————————————————————————————————
model Curriculum {
  id          String   @id @default(cuid())
  code        String   @unique  // "K12-VN", "CAMBRIDGE-PRIMARY", "IB-PYP", "IELTS"
  name        String            // "Chương trình K12 Việt Nam"
  description String?
  gradeMin    Int?              // 1
  gradeMax    Int?              // 12
  ageMin      Int?
  ageMax      Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@map("avab_curricula")
}

model Enrollment {
  id             String    @id @default(cuid())
  organizationId String?   // scoped to org
  campusId       String?   // scoped to campus
  academicYearId String?   // scoped to academic year
  userId    String
  courseId  String
  status    String    @default("ACTIVE") // ACTIVE | EXPIRED | PENDING | REMOVED
  note      String?
  notified  Boolean   @default(false)
  isFree    Boolean   @default(false)    // Miễn học phí
  expiresAt DateTime?                    // Ngày hết hạn (PER_COURSE: +18 tháng từ ngày bắt đầu)
  parentName String?                     // Họ tên Phụ Huynh
  pausedAt  DateTime?                     // Ngày tạm dừng học
  resumedAt DateTime?                     // Ngày tiếp tục học (null = đang nghỉ)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tuitionPayments TuitionPayment[]

  @@unique([userId, courseId])
  @@map("avab_enrollments")
}

model Subject {
  id          String   @id @default(cuid())
  courseId    String
  order       Int      @default(0)
  name        String
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials        SubjectMaterial[]
  questions        Question[]
  homeworkSets     HomeworkSet[]
  sessionFeedbacks SessionFeedback[]

  @@map("avab_subjects")
}

model HomeworkSet {
  id              String   @id @default(cuid())
  subjectId       String
  title           String
  order           Int      @default(0)
  fileUrl         String?
  isAIGenerated   Boolean  @default(false) // AI tự sinh cho học viên
  aiGeneratorId   String?  // userId của học viên đã yêu cầu sinh
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("avab_homework_sets")
}

model SubjectMaterial {
  id        String   @id @default(cuid())
  subjectId String
  type      String
  title     String?
  content   String?
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("avab_subject_materials")
}

model Question {
  id            String   @id @default(cuid())
  subjectId     String
  homeworkSetId String?
  order         Int      @default(0)
  questionType  String   @default("OPEN")
  content       String
  imageUrl      String?
  audioUrl      String?
  options       Json?    // [{key:"A",text:"..."}, ...] for MULTIPLE_CHOICE; [{left,right}] for MATCHING
  correctAnswer String
  explanation   String?
  points        Int      @default(1)
  metadata      Json?    // extra data per question type
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  homeworkSet HomeworkSet? @relation(fields: [homeworkSetId], references: [id], onDelete: SetNull)
  answers     StudentAnswer[]

  @@map("avab_questions")
}

model StudentAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  subjectId  String
  answer     String
  isCorrect  Boolean  @default(false)
  score      Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("avab_student_answers")
}

model News {
  organizationId  String?   // null = AvaB platform news (public); non-null = org-specific
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String?
  content     String
  thumbnail   String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("avab_news")
}

model Recruitment {
  id           String   @id @default(cuid())
  title        String
  type         String
  description  String
  requirements String?
  benefits     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("avab_recruitments")
}

// ── Thu học phí ─────────────────────────────────────────────────────────────

// Một đợt thu học phí (admin tạo)
model TuitionCollection {
  id             String   @id @default(cuid())
  organizationId String?
  campusId       String?
  courseId    String
  title       String   // Ví dụ: "Thu học phí tháng 3/2026"
  sessions    Int      @default(0)  // Số buổi thu
  unitAmount  Int      @default(0)  // Số tiền mỗi buổi (căn cứ pricePerSession)
  totalAmount Int      @default(0)  // sessions * unitAmount (default, có thể ghi đè mỗi HS)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments TuitionPayment[]

  @@map("avab_tuition_collections")
}

// Chi tiết thu học phí của từng học viên trong 1 đợt thu
model TuitionPayment {
  id           String    @id @default(cuid())
  collectionId String
  enrollmentId String
  userId       String
  amount       Int       @default(0) // Số tiền (có thể thay đổi mỗi HS)
  isFree       Boolean   @default(false) // Miễn học phí
  isPaid       Boolean   @default(false) // Đã đóng chưa
  paidAt       DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  collection TuitionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  enrollment Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([collectionId, enrollmentId])
  @@map("avab_tuition_payments")
}

// ── Nhận xét buổi học (PER_SESSION) ────────────────────────────────────────

// Một buổi học cụ thể (admin/GV tạo sau mỗi buổi dạy)
model SessionFeedback {
  id             String   @id @default(cuid())
  organizationId String?
  campusId       String?
  subjectId   String
  sessionDate DateTime @default(now())
  sessionNote String?  // Ghi chú chung về buổi học
  createdBy   String   // userId của GV/admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  records StudentSessionRecord[]

  @@map("avab_session_feedbacks")
}

// Nhận xét từng học sinh trong 1 buổi học
model StudentSessionRecord {
  id                 String    @id @default(cuid())
  feedbackId         String
  userId             String
  // Ma trận tiêu chí nhanh
  attendance         Boolean   @default(true)   // Có mặt
  focusLevel         Int?                        // Tập trung 1–5
  participationLevel Int?                        // Tham gia 1–5
  speakingCount      Int?                        // Số lần phát biểu
  answerQuality      Int?                        // Kết quả trả lời 1–5
  comprehension      Int?                        // Hiểu bài 1–5
  discipline         Int?                        // Ý thức học tập 1–5
  // Kỹ năng tư duy
  observation        Int?                        // Quan sát 1–5
  comparison         Int?                        // So sánh 1–5
  classification     Int?                        // Phân loại 1–5
  patternRecognition Int?                        // Quy luật 1–5
  expression         Int?                        // Diễn đạt 1–5
  // Cảm xúc/thái độ
  emotionState       String?                     // great/good/neutral/tired/frustrated
  // Ghi chú GV và AI nhận xét
  teacherNote        String?
  aiComment          String?   // AI sinh nhận xét
  aiCommentAt        DateTime?
  // Điểm BTVN (tự động cập nhật từ StudentAnswer)
  hwScore            Int?      // % (điểm trung bình BTVN buổi trước)
  hwCorrect          Int?      // Số câu đúng
  hwTotal            Int?      // Tổng câu
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  feedback SessionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@unique([feedbackId, userId])
  @@map("avab_student_session_records")
}

// Theo dõi số lần học viên yêu cầu AI sinh bài tập (tối đa 3 lần/chủ đề)
model AIQuizGenLog {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  genCount  Int      @default(0)  // Số lần đã sinh
  lastScore Int      @default(0)  // Điểm lần cuối (%) để check >=60%
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, subjectId])
  @@map("avab_ai_quiz_gen_log")
}

// Cache kết quả phân tích AI — 1 lần/2 tuần mỗi học viên
model AIAnalysisCache {
  id           String   @id @default(cuid())
  userId       String
  analysisType String   // diagnose | predict | intervene | recommend
  data         Json
  refreshedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, analysisType])
  @@map("avab_ai_analysis_cache")
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("avab_parent_student_links")
}

// ── AI Studio ─────────────────────────────────────────────────────────────

model AIProject {
  id          String   @id @default(cuid())
  title       String
  curriculum  String   @default("K12-VN") // K12-VN, CAMBRIDGE, IB...
  grade       String   // "1", "2", ..., "12", "preschool"
  subject     String   // MATH, ENGLISH, SCIENCE, CODING...
  subjectName String?
  chapter     String?  // Chương/Module
  topic       String   // Chủ đề
  objective   String?  // Mục tiêu học tập
  difficulty  String   @default("medium") // easy/medium/hard
  status      String   @default("draft") // draft/in-progress/review/published
  organizationId String?
  campusId       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps         AIProjectStep[]
  createdByUser User         @relation(fields: [createdBy], references: [id])
  organization  Organization? @relation("OrgAIProjects", fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("avab_ai_projects")
}

model AIProjectStep {
  id        String   @id @default(cuid())
  projectId String
  stepType  String   // curriculum/lesson/homework/qa/preview/publish
  stepNum   Int      // 1-8
  status    String   @default("pending") // pending/running/done/error/skipped
  content   String?  @db.Text // Generated content (markdown)
  metadata  Json?
  startedAt DateTime?
  doneAt    DateTime?
  error     String?

  project AIProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("avab_ai_project_steps")
}

// ── Organization & Campus Foundation ──────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique  // avab.vn/org/[slug]
  logo        String?
  domain      String?            // custom domain: abc.avab.vn
  type        String    @default("CENTER") // SCHOOL | CENTER | CHAIN
  country     String    @default("VN")
  timezone    String    @default("Asia/Ho_Chi_Minh")
  currency    String    @default("VND")
  // Modules enabled for this org (JSON array)
  modules     Json?     // ["erp","finance","crm","hrm","collab"]
  settings    Json?     // branding, theme, custom fields
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  campuses         Campus[]
  organizationUsers OrganizationUser[]
  courses          Course[]     @relation("OrgCourses")
  aiProjects       AIProject[]  @relation("OrgAIProjects")

  @@map("avab_organizations")
}

model Campus {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?   // short code: "Q1", "BD", "HN"
  address        String?
  phone          String?
  email          String?
  principalId    String?   // FK → User (set manually)
  settings       Json?     // campus-specific overrides
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campusUsers  CampusUser[]

  @@index([organizationId])
  @@map("avab_campuses")
}

// User ↔ Organization (M:M — user có thể thuộc nhiều org)
model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  orgRole        String   @default("MEMBER") // OWNER | ADMIN | MEMBER
  isDefault      Boolean  @default(true)     // tổ chức chính của user
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("avab_organization_users")
}

// User ↔ Campus (M:M — giáo viên có thể dạy nhiều cơ sở)
model CampusUser {
  id        String   @id @default(cuid())
  campusId  String
  userId    String
  campusRole String? // override role tại campus này
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campusId, userId])
  @@map("avab_campus_users")
}

// Academic Year — scoped to Organization
model AcademicYear {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // "Năm học 2025-2026"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("avab_academic_years")
}

// ── RBAC — Role & Permission (mục 10 + yêu cầu RBAC) ─────────────────────────

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. 'course.create'
  module      String           // course | lesson | homework | student | ai | finance ...
  action      String           // view | create | edit | delete | publish | generate | approve | export
  name        String           // Human-readable
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("avab_permissions")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique // super-admin | org-owner | teacher | student ...
  description String?
  level       String           // SYSTEM | ORGANIZATION | ACADEMIC | OPERATION | END_USER
  color       String   @default("gray") // for UI badge
  isSystem    Boolean  @default(false)  // cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("avab_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("avab_role_permissions")
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  scopeType String?   // platform | organization | campus | department | class | course
  scopeId   String?   // ID of the scoped entity (null = all)
  grantedBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@map("avab_user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String           // created | updated | deleted | approved | published | login ...
  entityType String           // role | permission | user | course | lesson ...
  entityId   String?
  summary    String?          // short human-readable summary
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("avab_audit_logs")
}

// ── Multi School (mục 15) ──────────────────────────────────────────

model School {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // "avab", "school-abc", "trung-tam-xyz"
  logo        String?           // URL
  domain      String?  @unique  // "abc.avab.vn" or custom domain
  primaryColor String  @default("#7c3aed") // brand color
  description String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolUsers   SchoolUser[]
  schoolCourses SchoolCourse[]
  settings      SchoolSettings?

  @@map("avab_schools")
}

model SchoolSettings {
  id                String  @id @default(cuid())
  schoolId          String  @unique
  allowSelfRegister Boolean @default(false)
  maxStudents       Int?    // null = unlimited
  features          Json?   // { gamification: true, ai_studio: true, ... }
  customCSS         String? @db.Text

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("avab_school_settings")
}

model SchoolUser {
  id       String @id @default(cuid())
  schoolId String
  userId   String
  role     String @default("STUDENT") // role within this school

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("avab_school_users")
}

model SchoolCourse {
  id       String @id @default(cuid())
  schoolId String
  courseId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([schoolId, courseId])
  @@index([schoolId])
  @@map("avab_school_courses")
}

// ── Workflow Engine (BPM) ─────────────────────────────────────────────

// Workflow Definition (blueprint)
model WorkflowDef {
  organizationId  String?
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  module      String   @default("general") // enrollment | content | finance | hr | general
  isTemplate  Boolean  @default(false)
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  steps       Json     // [{ id, type, name, config, nextSteps[], conditions[] }]
  formSchema  Json?    // form fields per step
  settings    Json?    // SLA, notifications, permissions
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances WorkflowInstance[]

  @@map("avab_workflow_defs")
}

// Running workflow instance
model WorkflowInstance {
  organizationId  String?
  id           String    @id @default(cuid())
  workflowId   String
  title        String
  entityType   String?   // course | content | enrollment | leave | purchase
  entityId     String?   // ID of the related entity
  status       String    @default("running") // running | completed | rejected | cancelled | on_hold
  currentStep  String    // step ID in workflowDef.steps
  data         Json?     // form data collected through steps
  startedBy    String?
  assignedTo   String?   // current assignee
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflow     WorkflowDef      @relation(fields: [workflowId], references: [id])
  history      WorkflowHistory[]

  @@index([workflowId])
  @@index([status])
  @@index([entityType, entityId])
  @@map("avab_workflow_instances")
}

// Step execution history per instance
model WorkflowHistory {
  id          String   @id @default(cuid())
  instanceId  String
  stepId      String
  stepName    String
  action      String   // approve | reject | submit | reassign | comment | auto
  actorId     String?
  note        String?
  data        Json?    // form data at this step
  duration    Int?     // seconds taken
  createdAt   DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("avab_workflow_history")
}

// ── Data Migration Center ───────────────────────────────────────

model MigrationLog {
  id           String    @id @default(cuid())
  module       String    // students | teachers | courses | classes | rooms | finance | questions | all
  format       String    // excel | csv | json | xml
  fileName     String
  fileSize     Int       @default(0)
  totalRows    Int       @default(0)
  successRows  Int       @default(0)
  failedRows   Int       @default(0)
  status       String    @default("pending") // pending | analyzing | mapping | validating | importing | done | failed | rolled_back
  mapping      Json?     // { sourceCol: targetField, ... }
  errors       Json?     // [{ row, field, message }]
  summary      Json?     // { created, updated, skipped }
  importedBy   String?
  canRollback  Boolean   @default(true)
  rolledBackAt DateTime?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status])
  @@index([module])
  @@map("avab_migration_logs")
}

// ── Teaching Material Import ─────────────────────────────────────

model MaterialImportLog {
  id              String    @id @default(cuid())
  // Source info
  sourceType      String    // docx | pdf | pptx | xlsx | csv | url | zip | google_drive
  sourceName      String    // original filename or URL
  sourceSize      Int       @default(0)
  // AI detection
  detectedType    String?   // lesson | homework | quiz | answer_key | slide | reference
  detectedSubject String?   // MATH | ENGLISH | SCIENCE...
  detectedGrade   String?   // 1-12 | preschool
  // Mapping result
  targetModule    String?   // subject_material | question | homework_set | ai_project
  targetId        String?   // ID of created/updated entity
  mappingData     Json?     // full mapping decisions
  // Processing
  status          String    @default("pending") // pending | analyzing | mapping | importing | qa | done | failed
  questionsFound  Int       @default(0)
  questionsImported Int     @default(0)
  errorsJson      Json?
  aiAnalysis      String?   @db.Text  // full AI analysis result
  // Ownership
  importedBy      String?
  subjectId       String?   // target subject
  canRollback     Boolean   @default(true)
  rolledBackAt    DateTime?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([importedBy])
  @@index([status])
  @@map("avab_material_import_logs")
}

// ── Gamification (mục 13) ────────────────────────────────────────

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique  // "first-login" | "perfect-score" | "10-lessons" ...
  name        String
  description String?
  icon        String            // emoji or icon key
  color       String   @default("yellow")  // for UI
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  condition   Json?             // { type: 'lessons_done', count: 10 } etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("avab_badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("avab_user_badges")
}

model Mission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String
  type        String   @default("daily") // daily | weekly | achievement
  target      Int      @default(1)       // e.g. answer 5 questions
  metric      String                     // "questions_answered" | "lessons_viewed" | "login" ...
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userMissions UserMission[]

  @@map("avab_missions")
}

model UserMission {
  id        String    @id @default(cuid())
  userId    String
  missionId String
  progress  Int       @default(0)   // current progress toward target
  completed Boolean   @default(false)
  claimedAt DateTime?
  resetAt   DateTime?              // for daily/weekly resets
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("avab_user_missions")
}

model UserStats {
  id         String   @id @default(cuid())
  userId     String   @unique
  xp         Int      @default(0)
  coin       Int      @default(0)
  level      Int      @default(1)
  streak     Int      @default(0)    // consecutive login days
  lastLoginAt DateTime?
  totalAnswers  Int   @default(0)
  correctAnswers Int  @default(0)
  lessonsViewed  Int  @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avab_user_stats")
}

model XPLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // "answer_correct" | "lesson_complete" | "badge_earned" | "mission_complete" ...
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("avab_xp_logs")
}

// ── Job Queue (mục 9) ──────────────────────────────────────────────────
model JobQueue {
  id          String    @id @default(cuid())
  courseId    String?
  subjectId   String?
  jobType     String    // generate-lessons | generate-homework | generate-answers | generate-quiz | generate-teacher-guide | generate-video-script | generate-all
